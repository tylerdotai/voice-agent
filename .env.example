# Copy to .env for local Docker/SIP testing. Do not commit real values.

# LiveKit dev/demo credentials. Replace before exposing beyond localhost.
LIVEKIT_KEYS=devkey:replace-with-random-secret
LIVEKIT_SECRET=replace-with-random-secret
LIVEKIT_REGION=us-east-1

# Optional SIP / Asterisk Manager Interface settings.
ASTERISK_HOST=localhost
ASTERISK_PORT=5038
ASTERISK_USER=voiceagent
ASTERISK_PASSWORD=
SIP_EXTENSION=6000
SIP_PASSWORD=
SIP_CONTEXT=voice-agent

# Runtime defaults.
VOICE_AGENT_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://ollama:11434
